# ─────────────────────────────────────────────────────────────────────────────
# EMY Studio — developer configuration
# Copy to .env.local (laptop) or set in Vercel → Settings → Environment Variables
# (hosted). Set ONCE by the developer; the app is handed over fully working —
# the artist never sees these.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI: Gemini (free tier) ───────────────────────────────────────────────────
# Powers the open-ended assistant chat and (fallback) AI cover art.
# Get a free key: https://aistudio.google.com/apikey  (no card required)
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── AI: fal.ai (top image models: Flux / Recraft / Ideogram) ─────────────────
# Powers AI cover art with the best open image models. Pay-per-image,
# free credits on signup: https://fal.ai/dashboard/keys
FAL_KEY=

# ── Email pings (when a master/export finishes) ──────────────────────────────
# Free at https://resend.com
RESEND_API_KEY=
STUDIO_NOTIFY_TO=
# RESEND_FROM=EMY Studio <studio@resend.dev>

# ── Improvement suggestions (from the artist) ────────────────────────────────
# She suggests features in the app → they land in the SQLite DB and (if this
# is set) you get an email with the AI's implementation plan.
DEV_FEEDBACK_TO=
# APP_URL=https://your-app.vercel.app   # used for the admin link in the email

# ── Developer back end (/studio/admin) ───────────────────────────────────────
# A password only you know. Enter it on /studio/admin to see every suggestion
# and mark them planned/done. Leave empty to keep the page locked out.
STUDIO_ADMIN_TOKEN=
