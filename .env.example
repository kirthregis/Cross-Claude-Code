# ---------------------------------------------------------------------------
# GigRadar — environment configuration. Copy to .env.local and fill in the
# pieces you want. Every value is optional: the app runs fine with nothing
# set (it seeds example gigs), and each unconfigured feature is skipped.
# ---------------------------------------------------------------------------

# --- Alerts: where she gets pinged (at least one is needed to actually alert) --
# WhatsApp (Meta Cloud API) — best channel, she's already there
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=                 # her number, digits only, e.g. 971506607743
# Outside a 24h reply window Meta needs an approved message template:
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# Email (Resend free tier)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=GigRadar <onboarding@resend.dev>

# Telegram (alternative, fastest free option) — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic webhook fallback (Slack/Discord/Make.com) — optional
ALERT_WEBHOOK_URL=

# Public base URL of the deployment (for full-deal links in alerts)
APP_URL=

# --- Web scan (NEW): scours the open web for UAE entertainment/booking leads ---
# FREE, no credentials. Google News RSS + your own feeds, run on the sweep.
WEB_SEARCH_ON=true
# Override the default queries (pipe "|" or comma separated). Add her target
# venue names / promoters to widen the net:
WEB_SEARCH_QUERIES=Dubai DJ booking|Dubai nightclub residency|Cove Beach OR Nikki Beach event
# Extra RSS/JSON feeds to scan (comma separated) — e.g. venue blogs, job boards:
WEB_SEARCH_EXTRA_FEEDS=

# --- Sources: what the radar watches -----------------------------------------
# Instagram promoter/venue accounts (via a scraper API — free tiers exist)
IG_SCRAPER_URL=
IG_SCRAPER_KEY=
IG_WATCH_HANDLES=            # comma separated, e.g. dubaipromoters,covebeachdubai

# Public event calendars / gig boards (RSS or JSON, comma separated)
CALENDAR_FEEDS=
BOARD_FEEDS=

# --- Inbound webhooks & auth --------------------------------------------------
# Shared key for inbound leads (WhatsApp / email) and the sweep endpoint
INGEST_KEY=
CRON_KEY=
